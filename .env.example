# Cursor user API key from https://cursor.com/dashboard/api (crsr_...).
# Set it server-side in Dokploy env; clients can then use any bearer token
# (e.g. "cursor-local"). If left empty, clients must send the real Cursor
# key as their Bearer token on every request.
CURSOR_API_KEY=

# Loopback-only mapping is done by the compose port rule (127.0.0.1:8788).
# Reach it over the tailnet: https://g5kc.tail1e9037.ts.net:8788/v1
CURSOR_API_PORT=8788
CURSOR_SDK_BRIDGE_TIMEOUT_MS=180000
